{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "files": {
        "includes": [
            "**/*.json",
            "**/assets/css/**",
            "**/assets/js/**",
            "**/tests/Browser/**/*.js",
            "**/tests/Browser/public/**",
            "**/tests/Browser/assets/**",
            "**/tests/Consumer/**/*.js",
            "**/examples/consumer/assets/**",
            "**/examples/consumer/tailwind/**",
            "**/tests/build/**/*.js",
            "!**/composer.json",
            "!**/vendor",
            "!**/package.json",
            "!**/node_modules",
            "!**/var",
            "!**/tests/Browser/results",
            "!**/tests/Browser/public/assets-built",
            "!**/tests/Consumer/results",
            "!**/examples/consumer/public/assets",
            "!**/.claude",
            "!**/public/entrypoints.json",
            "!**/public/manifest.json"
        ]
    },
    "linter": {
        "rules": {
            "suspicious": {
                "noExplicitAny": "off",
                "noEmptyBlockStatements": "off"
            },
            "complexity": {
                "noStaticOnlyClass": "off",
                "noForEach": "off"
            },
            "style": {
                "noParameterAssign": "off"
            },
            "performance": {
                "noDelete": "off"
            }
        }
    },
    "formatter": {
        "lineWidth": 120,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "javascript": {
        "formatter": {
            "trailingCommas": "es5",
            "bracketSameLine": true,
            "quoteStyle": "single"
        }
    },
    "overrides": [
        {
            "includes": ["**/*.svelte"],
            "linter": {
                "rules": {
                    "style": {
                        "useConst": "off"
                    }
                }
            }
        },
        {
            "includes": [
                "assets/css/app.css",
                "assets/css/ui-preview.css",
                "assets/css/ui-fonts-preview.css",
                "assets/css/ui/**",
                "assets/css/form-type-code-editor.css",
                "assets/css/form-type-text-editor.css",
                "assets/css/migration-*.css",
                "tests/Browser/assets/**",
                "examples/consumer/assets/**/*.css",
                "examples/consumer/tailwind/**/*.css"
            ],
            "css": {
                "formatter": {
                    "quoteStyle": "single"
                }
            }
        }
    ],
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    }
}
