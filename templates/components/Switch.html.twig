{% props
    ## bool Whether the switch is on.
    checked = false,
    ## bool Whether the switch is disabled.
    disabled = false,
    ## string|null The `name` attribute of the input (for form submission).
    name = null,
    ## string The value submitted when the switch is checked.
    value = '1',
    ## string|null The `id` attribute of the input (to wire an external `<label for="...">`).
    id = null,
    ## bool Whether the switch is required.
    required = false,
    ## 'sm'|'md'|Size The size of the switch (a string or a `Size` enum case).
    size = 'md',
    ## 'success'|'warning'|'danger'|null The color of the checked state (it matches the button colors).
    variant = null,
    ## string|null The accessible name of the switch, needed when there is no visible label.
    ariaLabel = null,
%}

{% set size_value = size.value is defined ? size.value : size %}
{% set variant_value = variant.value is defined ? variant.value : variant %}
{% set css_class = html_classes('ea-switch',
    size_value != 'md' ? 'ea-switch-' ~ size_value,
    variant_value in ['success', 'warning', 'danger'] ? 'ea-switch-' ~ variant_value,
    {
        'ea-switch-disabled': disabled,
    },
) %}
{% set caller_classes = attributes.render('class')|default('') %}
{% set ui_attributes = attributes.only().defaults(ea_ui_attrs(attributes.all)).without('class') %}
{% set input_classes = ea_ui_classes(html_classes('ea-switch-input toggle',
    size_value != 'md' ? 'ea-switch-' ~ size_value,
    variant_value in ['success', 'warning', 'danger'] ? 'ea-switch-' ~ variant_value,
    caller_classes,
), 'switch') %}
{% set input_defaults = {type: 'checkbox', role: 'switch', class: input_classes, value: value, autocomplete: 'off'} %}
{% if id %}{% set input_defaults = input_defaults|merge({id: id}) %}{% endif %}
{% if name %}{% set input_defaults = input_defaults|merge({name: name}) %}{% endif %}
{% if checked %}{% set input_defaults = input_defaults|merge({checked: true}) %}{% endif %}
{% if disabled %}{% set input_defaults = input_defaults|merge({disabled: true}) %}{% endif %}
{% if required %}{% set input_defaults = input_defaults|merge({required: true}) %}{% endif %}
{% if ariaLabel %}{% set input_defaults = input_defaults|merge({'aria-label': ariaLabel}) %}{% endif %}

<span class="{{ css_class }}">
    <input {{- ui_attributes.defaults(input_defaults) }}>
    <span class="ea-switch-track" aria-hidden="true"><span class="ea-switch-thumb"></span></span>
</span>{#--#}
