{#
This component renders a native dialog with the shared EasyAdmin interactions.

To open/close the modal use the `<twig:ea:Modal:Trigger target="#id">` and
`<twig:ea:Modal:Close>` helpers.

Usage examples:

    # a confirmation dialog opened by a trigger button
    <twig:ea:Modal:Trigger target="#delete-modal" color="danger" icon="internal:delete">Delete</twig:ea:Modal:Trigger>

    <twig:ea:Modal id="delete-modal" title="Delete this item?" description="This action cannot be undone.">
        <twig:block name="footer">
            <twig:ea:Modal:Close>Cancel</twig:ea:Modal:Close>
            <twig:ea:Button color="danger" variant="solid" data-ea-dismiss="modal">Delete</twig:ea:Button>
        </twig:block>
    </twig:ea:Modal>

    # custom body content and a wider window
    <twig:ea:Modal id="details-modal" size="lg">
        <twig:block name="body"><p>Any markup you need goes here.</p></twig:block>
        <twig:block name="footer">
            <twig:ea:Modal:Close>Close</twig:ea:Modal:Close>
        </twig:block>
    </twig:ea:Modal>

    # confirmation style with an icon stacked on top
    <twig:ea:Modal id="warn-modal" topIcon="internal:circle-exclamation" title="Are you sure?">
        <twig:block name="footer">
            <twig:ea:Modal:Close>No</twig:ea:Modal:Close>
            <twig:ea:Button color="primary" data-ea-dismiss="modal">Yes</twig:ea:Button>
        </twig:block>
    </twig:ea:Modal>
#}

{% props
    ## string|null The main text shown in the modal window (it may contain HTML).
    title = null,
    ## string|null The smaller optional text shown below the title (it may contain HTML).
    description = null,
    ## 'sm'|'lg'|'xl'|null The window width: `sm` 320px, default 380px, `lg` 512px, `xl` 800px.
    size = null,
    ## string|null The name of the optional icon shown at the top left of the window.
    icon = null,
    ## string|null The name of the optional icon shown on top of the modal contents.
    topIcon = null,
    ## string Custom CSS class(es) added to the modal header HTML element.
    headerClass = '',
    ## string Custom CSS class(es) added to the modal body HTML element.
    bodyClass = '',
    ## string Custom CSS class(es) added to the modal footer HTML element.
    footerClass = '',
%}
{% set modalIcon = topIcon ?? icon %}
{% set attributes = attributes.only().defaults(attributes.all|ea_ui_attrs) %}
{% set dialog_id = attributes.all.id|default(ea_uid('ea-dialog-')) %}
{% set dialog_attrs = {id: dialog_id, class: html_classes('modal ea-dialog', size ? 'ea-dialog-' ~ size), tabindex: '-1', 'data-ea-dialog': true} %}
{% if title %}{% set dialog_attrs = dialog_attrs|merge({'aria-labelledby': dialog_id ~ '-title'}) %}{% endif %}
{% if description %}{% set dialog_attrs = dialog_attrs|merge({'aria-describedby': dialog_id ~ '-description'}) %}{% endif %}
<dialog {{ attributes.defaults(dialog_attrs) }}>
    <div class="modal-box modal-content ea-dialog-panel" data-ea-dialog-panel>
            {% if block('header') is not empty %}
                <div class="modal-header {{ ea_ui_classes(headerClass) }}">{## The contents of the modal header; the header is not rendered when this block is empty. ##}{% block header %}{% endblock %}</div>
            {% endif %}
            <div class="modal-body {{ ea_ui_classes(bodyClass) }} {{ modalIcon ? (topIcon ? 'modal-body--top-icon' : 'modal-body--icon') }}">
                {% if modalIcon %}<span class="modal-icon {{ topIcon ? 'modal-icon--top' }}"><twig:ea:Icon name="{{ modalIcon }}" /></span>{% endif %}
                <div class="modal-body-content">
                    {% if title %}<h4 id="{{ dialog_id }}-title">{{ title|raw }}</h4>{% endif %}
                    {% if description %}<p id="{{ dialog_id }}-description">{{ description|raw }}</p>{% endif %}
                    {## Custom contents displayed below the title and the description. -#}
                    {% block body %}{% endblock %}
                </div>
            </div>
            {% if block('footer') is not empty %}
                <div class="modal-footer {{ ea_ui_classes(footerClass) }}">{## The contents of the modal footer (usually its buttons); the footer is not rendered when this block is empty. ##}{% block footer %}{% endblock %}</div>
            {% endif %}
    </div>
</dialog>
