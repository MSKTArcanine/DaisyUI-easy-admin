{#
    Button that opens a Modal. Wraps `<twig:ea:Button>` and adds the native interaction
    attributes needed to open the target dialog. The label goes in the default slot; any other
    Button prop (color, variant, icon, size, …) is forwarded.

    Usage: <twig:ea:Modal:Trigger target="#my-modal" color="primary">Open</twig:ea:Modal:Trigger>
#}
{% props
    ## string The CSS selector of the modal to open (e.g. `#delete-modal`).
    target,
    ## string The `type` attribute of the button.
    type = 'button',
%}
<twig:ea:Button type="{{ type }}" data-ea-toggle="modal" data-ea-target="{{ target }}" {{ ...attributes }}>{{ block(outerBlocks.content) }}</twig:ea:Button>
