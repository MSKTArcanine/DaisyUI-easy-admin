{% set attributes = attributes.only().defaults(attributes.all|ea_ui_attrs) %}
{# ActionMenu is a component to create dropdowns of related actions.
   It defines several sub-components (Overlay, ActionList, etc.)
   Inspired by https://primer.style/components/action-menu
#}
<div {{ attributes.defaults({class: 'dropdown ea-action-menu', 'data-ea-action-menu': true}) }}>
    {## The contents of the menu (usually `Button` and `Overlay` sub-components). -#}
    <twig:block name="content"></twig:block>
</div>
