{% types {
    field: '\\EasyCorp\\Bundle\\EasyAdminBundle\\Dto\\FieldDto',
    entity: '\\EasyCorp\\Bundle\\EasyAdminBundle\\Dto\\EntityDto',
} %}
{% if ea().crud.currentAction == 'detail' %}
    {{ field.formattedValue|nl2br }}
{% else %}
    {% set html_id = 'ea-text-editor-' ~ field.uniqueId %}
    <a href="#" data-ea-toggle="modal" data-ea-target="#{{ html_id }}">
        <twig:ea:Icon name="internal:file-lines" /> {{ 'field.text_editor.view_content'|trans([], domain: 'EasyAdminBundle') }}
    </a>

    <twig:ea:Modal id="{{ html_id }}" size="xl" headerClass="flex items-center justify-between gap-4" bodyClass="ea-prose" aria-labelledby="{{ html_id ~ '-title' }}">
        <twig:block name="header">
            <h5 class="modal-title" id="{{ html_id ~ '-title' }}">{{ field.label|trans }}</h5>
            <twig:ea:Modal:Close variant="ghost" icon="internal:xmark" aria-label="{{ 'action.close'|trans([], domain: 'EasyAdminBundle') }}" />
        </twig:block>
        <twig:block name="body">{{ field.formattedValue|nl2br }}</twig:block>
    </twig:ea:Modal>
{% endif %}
