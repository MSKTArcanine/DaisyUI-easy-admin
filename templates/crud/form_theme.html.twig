{% use '@EasyAdmin/symfony-form-themes/form_div_layout.html.twig' with form_widget_compound as ea_base_form_widget_compound %}
{% use '@EasyAdmin/crud/form_theme_layout.html.twig' %}

{% block form_start %}
    {% if form.vars.errors|length > 0 and 'ea_crud' in form.vars.block_prefixes|default([]) %}
        {{ form_errors(form, {attr: {errorClass: 'global-invalid-feedback'}}) }}
    {% endif %}
    {{ parent() }}
{% endblock %}

{% block form_end %}
    {% if not render_rest is defined or render_rest %}{{ form_rest(form) }}{% endif %}
    </form>
{% endblock %}

{% block form_errors %}
    {% if errors|length > 0 %}
        <div id="{{ id }}_errors" class="{{ html_classes('ea-form-errors invalid-feedback', attr.errorClass|default('')) }}" role="alert">
            {% for error in errors %}<div class="form-error">{{ error.message }}</div>{% endfor %}
        </div>
    {% endif %}
{% endblock %}

{% block form_widget_simple %}
    {% set widget_class = type|default('text') == 'hidden' ? '' : (type|default('text') == 'file' ? 'file-input' : (type|default('text') == 'range' ? 'range' : 'input')) %}
    {% set invalid_class = widget_class == 'file-input' ? 'file-input-error' : (widget_class == 'range' ? 'range-error' : 'input-error') %}
    {% if widget_class is not empty %}
        {% set attr = attr|merge({class: html_classes(attr.class|default(''), widget_class, not valid ? invalid_class)}) %}
    {% endif %}
    {{ parent() }}
{% endblock %}

{% block textarea_widget %}
    {% set attr = attr|merge({class: html_classes(attr.class|default(''), 'textarea', {'textarea-error': not valid})}) %}
    {{ parent() }}
{% endblock %}

{% block file_widget %}
    {% set type = type|default('file') %}
    {{ block('form_widget_simple') }}
{% endblock %}

{% block widget_attributes %}
    {% if not valid %}{% set attr = attr|merge({'aria-invalid': 'true'}) %}{% endif %}
    {{ parent() }}
{% endblock %}

{% block widget_container_attributes %}
    {% if not valid %}{% set attr = attr|merge({'aria-invalid': 'true'}) %}{% endif %}
    {{ parent() }}
{% endblock %}

{% block money_widget %}
    {% if ea_widget_is_inside_addon_group|default(false) %}{{ block('form_widget_simple') }}{% else %}{{ parent() }}{% endif %}
{% endblock %}

{% block percent_widget %}
    {% if ea_widget_is_inside_addon_group|default(false) %}{{ block('form_widget_simple') }}{% else %}{{ parent() }}{% endif %}
{% endblock %}

{% block choice_widget_collapsed %}
    {% set attr = attr|merge({class: html_classes(attr.class|default(''), 'select', {'select-error': not valid})}) %}
    {% if 'ea-autocomplete' == attr['data-ea-widget']|default(false) %}
        {% set attr = attr|merge({
            'data-ea-i18n-no-results-found': 'autocomplete.no-results-found'|trans({}, 'EasyAdminBundle'),
            'data-ea-i18n-no-more-results': 'autocomplete.no-more-results'|trans({}, 'EasyAdminBundle'),
            'data-ea-i18n-loading-more-results': 'autocomplete.loading-more-results'|trans({}, 'EasyAdminBundle'),
        }) %}
    {% endif %}
    {{ parent() }}
{% endblock %}

{% block choice_widget_expanded %}
    {% set attr = attr|merge({class: html_classes(attr.class|default(''), 'ea-expanded-choice', {'ea-choice-inline': '-inline' in label_attr.class|default('')})}) %}
    <div {{ block('widget_container_attributes') }}>
        {% for child in form %}
            {{ form_widget(child, {parent_label_class: label_attr.class|default(''), translation_domain: choice_translation_domain, valid: valid}) }}
        {% endfor %}
    </div>
{% endblock %}

{% block checkbox_widget %}
    {% set parent_label_class = parent_label_class|default(label_attr.class|default('')) %}
    {% if 'checkbox-switch' in parent_label_class %}
        {% set switch_variant = 'checkbox-switch-success' in parent_label_class ? 'success' : ('checkbox-switch-warning' in parent_label_class ? 'warning' : ('checkbox-switch-danger' in parent_label_class ? 'danger' : null)) %}
        {% if not valid %}{% set attr = attr|merge({class: html_classes(attr.class|default(''), 'is-invalid'), 'aria-invalid': 'true'}) %}{% endif %}
        {% set switch_widget %}
            <twig:ea:Switch id="{{ id }}" name="{{ full_name }}" value="{{ value }}" checked="{{ checked ?? false }}" disabled="{{ disabled ?? false }}" required="{{ required ?? false }}" variant="{{ switch_variant }}" {{ ...attr }} />
        {% endset %}
        <div class="ea-choice-row form-check ea-switch-check">{{ form_label(form, null, {widget: switch_widget}) }}</div>
    {% else %}
        {% set attr = attr|merge({class: html_classes(attr.class|default(''), 'checkbox form-check-input', {'checkbox-error': not valid})}) %}
        <div class="{{ html_classes('ea-choice-row form-check', {'ea-choice-inline form-check-inline': 'checkbox-inline' in parent_label_class}) }}">
            {{ form_label(form, null, {widget: parent()}) }}
        </div>
    {% endif %}
{% endblock %}

{% block radio_widget %}
    {% set parent_label_class = parent_label_class|default(label_attr.class|default('')) %}
    {% set attr = attr|merge({class: html_classes(attr.class|default(''), 'radio form-check-input', {'radio-error': not valid})}) %}
    <div class="{{ html_classes('ea-choice-row form-check', {'ea-choice-inline form-check-inline': 'radio-inline' in parent_label_class}) }}">
        {{ form_label(form, null, {widget: parent()}) }}
    </div>
{% endblock %}

{% block checkbox_label %}{{ block('checkbox_radio_label') }}{% endblock %}
{% block radio_label %}{{ block('checkbox_radio_label') }}{% endblock %}

{% block checkbox_radio_label %}
    {% if widget is defined %}
        {% set label_attr = label_attr|merge({for: id, class: html_classes(label_attr.class|default(''), 'ea-choice-label form-check-label', {required: required})}) %}
        {% set has_label = label is not same as(false) and label is not null and label is not same as('') %}
        {% if label is not same as(false) and not has_label %}
            {% set label = label_format is not empty ? label_format|replace({'%name%': name, '%id%': id}) : name|humanize %}
        {% endif %}
        {{ widget|raw }}
        <label {% with {attr: label_attr} %}{{ block('attributes') }}{% endwith %}>
            {% if label is not same as(false) %}
                {% set translated_label = translation_domain is same as(false) ? label : label|trans(label_translation_parameters|default({}), translation_domain) %}
                {{ label_html|default(false) ? translated_label|raw : translated_label }}
            {% endif %}
        </label>
    {% endif %}
{% endblock %}

{% block choice_label %}
    {% set label_attr = label_attr|merge({class: label_attr.class|default('')|replace({'checkbox-inline': '', 'radio-inline': '', 'checkbox-custom': '', 'radio-custom': '', 'switch-custom': ''})|trim}) %}
    {{ block('form_label') }}
{% endblock %}

{% block form_label %}
    {% if label is not same as(false) %}
        {% if compound %}
            {% set element = 'legend' %}
            {% set label_attr = label_attr|merge({class: html_classes(label_attr.class|default(''), 'ea-form-label col-form-label')}) %}
        {% else %}
            {% set label_attr = label_attr|merge({for: id, class: html_classes(label_attr.class|default(''), 'ea-form-label form-control-label')}) %}
        {% endif %}
        {% if required %}{% set label_attr = label_attr|merge({class: html_classes(label_attr.class|default(''), 'required')}) %}{% endif %}
        {% if label is null %}
            {% set label = label_format is not empty ? label_format|replace({'%name%': name, '%id%': id}) : name|humanize %}
        {% endif %}
        <{{ element|default('label') }} {% with {attr: label_attr} %}{{ block('attributes') }}{% endwith %}>
            {% set translated_label = translation_domain is same as(false) ? label : label|trans(label_translation_parameters|default({}), translation_domain) %}
            {{ label_html|default(false) ? translated_label|raw : translated_label }}
        </{{ element|default('label') }}>
    {% endif %}
{% endblock %}

{% block form_help %}
    {% set help_attr = help_attr|merge({class: html_classes(help_attr.class|default(''), 'form-help ea-form-help')}) %}
    {{ parent() }}
{% endblock %}

{% block ea_form_row_content %}
    {% set field = form.vars.ea_vars.field|default(null) %}
    {% set field_help = field is not null and field.help is ea_is_not_empty %}
    {% set row_help = field_help ? field.help : help %}
    {% set has_help = row_help is not same as(false) and row_help is not null and row_help is not same as('') %}
    {% set descriptions = attr['aria-describedby']|default('')|split(' ') %}
    {% if has_help and (id ~ '_help') not in descriptions %}{% set descriptions = descriptions|merge([id ~ '_help']) %}{% endif %}
    {% if errors|length > 0 and (id ~ '_errors') not in descriptions %}{% set descriptions = descriptions|merge([id ~ '_errors']) %}{% endif %}
    {% if descriptions|join(' ')|trim is not empty %}{% set attr = attr|merge({'aria-describedby': descriptions|join(' ')|trim}) %}{% endif %}
    {% set row_class = row_class|default(row_attr.class|default('')) %}
    {% set row_attr = row_attr|merge({class: html_classes(row_class, 'form-group ea-form-group', {'has-error': (not compound or force_error|default(false)) and not valid})}) %}
    {% set row_element = compound ? 'fieldset' : 'div' %}
    <{{ row_element }} {% with {attr: row_attr} %}{{ block('attributes') }}{% endwith %}>
        {{ form_label(form) }}
        <div class="form-widget">
            {% set ea_addons = ea_addons|default({prepend: [], append: []}) %}
            {% set has_addons = ea_addons.prepend is not empty or ea_addons.append is not empty %}
            {% if has_addons %}
                <div class="ea-input-group {{ disabled ? 'ea-input-group-disabled' }}">
                    {% for addon in ea_addons.prepend %}
                        <span class="ea-input-addon ea-input-addon-prepend">
                            {% if addon.icon %}<twig:ea:Icon name="{{ addon.icon }}" />{% endif %}{% if addon.html %}{{ addon.html|trans|raw }}{% elseif addon.text %}{{ addon.text }}{% endif %}
                        </span>
                    {% endfor %}
                    {{ form_widget(form, {attr: attr, ea_widget_is_inside_addon_group: true}) }}
                    {% for addon in ea_addons.append %}
                        <span class="ea-input-addon ea-input-addon-append">
                            {% if addon.icon %}<twig:ea:Icon name="{{ addon.icon }}" />{% endif %}{% if addon.html %}{{ addon.html|trans|raw }}{% elseif addon.text %}{{ addon.text }}{% endif %}
                        </span>
                    {% endfor %}
                </div>
            {% else %}
                {{ form_widget(form, {attr: attr}) }}
            {% endif %}
            {% if field_help %}
                {{ form_help(form, {help: row_help, help_html: true, help_translation_parameters: label_translation_parameters}) }}
            {% else %}
                {{ form_help(form) }}
            {% endif %}
            {{ form_errors(form) }}
        </div>
    </{{ row_element }}>
{% endblock %}

{% block choice_row %}{% set force_error = true %}{{ block('form_row') }}{% endblock %}
{% block date_row %}{% set force_error = true %}{{ block('form_row') }}{% endblock %}
{% block time_row %}{% set force_error = true %}{{ block('form_row') }}{% endblock %}
{% block datetime_row %}{% set force_error = true %}{{ block('form_row') }}{% endblock %}

{% block button_widget %}
    {% set attr = attr|merge({class: ea_ui_classes('btn ' ~ (attr.class|default('btn-neutral btn-outline')), 'button')}) %}
    {{ parent() }}
{% endblock %}

{% block submit_widget %}
    {% set attr = attr|merge({class: attr.class|default('btn-primary')}) %}
    {{ parent() }}
{% endblock %}

{% block button_row %}
    {% set row_attr = row_attr|merge({class: html_classes(row_attr.class|default(''), 'form-group ea-form-group')}) %}
    <div {% with {attr: row_attr} %}{{ block('attributes') }}{% endwith %}>{{ form_widget(form) }}</div>
{% endblock %}

{% block datetime_widget %}
    <div class="datetime-widget datetime-widget-datetime">
        {% if widget == 'single_text' %}
            {{ block('form_widget_simple') }}
        {% else %}
            <div {{ block('widget_container_attributes') }}>
                {{ form_widget(form.date, {datetime: true}) }}{{ form_errors(form.date) }}
                {{ form_widget(form.time, {datetime: true}) }}{{ form_errors(form.time) }}
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block date_widget %}
    {% if datetime|default(false) and errors|length > 0 %}
        {% set attr = attr|merge({'aria-describedby': (attr['aria-describedby']|default('') ~ ' ' ~ id ~ '_errors')|trim}) %}
    {% endif %}
    <div class="datetime-widget datetime-widget-date">
        {% if widget != 'single_text' %}
            <div class="sr-only">{{ form_label(form.year) }}{{ form_label(form.month) }}{{ form_label(form.day) }}</div>
        {% endif %}
        {{ parent() }}
    </div>
{% endblock %}

{% block time_widget %}
    {% if datetime|default(false) and errors|length > 0 %}
        {% set attr = attr|merge({'aria-describedby': (attr['aria-describedby']|default('') ~ ' ' ~ id ~ '_errors')|trim}) %}
    {% endif %}
    <div class="datetime-widget datetime-widget-time">
        {% if widget != 'single_text' %}
            <div class="sr-only">{{ form_label(form.hour) }}{% if with_minutes %}{{ form_label(form.minute) }}{% endif %}{% if with_seconds %}{{ form_label(form.second) }}{% endif %}</div>
        {% endif %}
        {{ parent() }}
    </div>
{% endblock %}

{% block dateinterval_widget %}
    {% if widget == 'single_text' %}
        {{ block('form_widget_simple') }}
    {% else %}
        {% set attr = attr|merge({class: html_classes(attr.class|default(''), 'datetime-widget datetime-widget-interval')}) %}
        <div {{ block('widget_container_attributes') }}>
            {% for part in ['years', 'months', 'weeks', 'days', 'hours', 'minutes', 'seconds'] %}
                {% if attribute(_context, 'with_' ~ part)|default(false) %}
                    <div class="datetime-widget-part">{{ form_label(form[part]) }}{{ form_widget(form[part]) }}</div>
                {% endif %}
            {% endfor %}
            {% if with_invert %}{{ form_widget(form.invert) }}{% endif %}
        </div>
    {% endif %}
{% endblock %}

{% block vich_file_row %}
    {% set force_error = true %}
    {{ block('form_row') }}
{% endblock %}

{% block vich_file_widget %}
    <div class="ea-vich-file">
        {% if download_uri|default('') is not empty %}
            <a class="ea-vich-file-name" href="{{ asset_helper is same as(true) ? asset(download_uri) : download_uri }}" {% if download_uri|split('/')|last|ea_force_download %}download rel="noopener"{% endif %}>
                <twig:ea:Icon name="internal:file-lines" />
                {%- if download_label|default(false) -%}
                    {{ translation_domain is same as(false) ? download_label : download_label|trans({}, translation_domain) }}
                {%- else -%}
                    {{ download_uri|split('/')|last ?: 'download'|trans({}, translation_domain) }}
                {%- endif -%}
            </a>
        {% endif %}

        {% set file_upload_js %}
            var newFile = document.getElementById('{{ form.file.vars.id }}').files[0];
            var fileSizeInMegabytes = newFile.size > 1024 * 1024;
            var fileSize = fileSizeInMegabytes ? newFile.size / (1024 * 1024) : newFile.size / 1024;
            document.getElementById('{{ form.file.vars.id }}_new_file_name').innerText = newFile.name + ' (' + fileSize.toFixed(2) + ' ' + (fileSizeInMegabytes ? 'MB' : 'KB') + ')';
        {% endset %}

        <div class="ea-vich-file-actions">
            {# the container element is needed to allow customizing the <input type="file" /> #}
            <div class="{{ ea_ui_classes('btn btn-secondary input-file-container', 'button') }}">
                <twig:ea:Icon name="internal:upload" /> {{ 'action.choose_file'|trans({}, 'EasyAdminBundle') }}
                {{ form_widget(form.file, {attr: {onchange: file_upload_js}, vich: true}) }}
            </div>

            {% if form.delete is defined %}
                {{ form_row(form.delete) }}
            {% endif %}
        </div>
        <div class="small" id="{{ form.file.vars.id }}_new_file_name"></div>
    </div>
{% endblock %}

{% block vich_image_row %}
    {% set force_error = true %}
    {{ block('form_row') }}
{% endblock %}

{% block vich_image_widget %}
    {% set formTypeOptions = ea_vars.field.formTypeOptions|default('') %}
    <div class="ea-vich-image">
        {% if image_uri|default('') is not empty %}
            {% if download_uri|default('') is empty %}
                <div class="ea-lightbox-thumbnail">
                    <img style="cursor: initial" src="{{ asset_helper is same as(true) ? asset(image_uri) : image_uri }}">
                </div>
            {% else %}
                {% set _lightbox_id = 'ea-lightbox-' ~ id %}

                <a href="{{ asset_helper is same as(true) ? asset(download_uri) : download_uri }}" target="_blank" rel="noopener" class="ea-lightbox-thumbnail" data-ea-lightbox-content-selector="#{{ _lightbox_id }}">
                    <img src="{{ asset_helper is same as(true) ? asset(image_uri) : image_uri }}">
                </a>

                <div id="{{ _lightbox_id }}" class="ea-lightbox">
                    <img src="{{ asset_helper is same as(true) ? asset(download_uri) : download_uri }}">
                </div>
            {% endif %}
        {% endif %}

        {% set file_upload_js %}
            var newFile = document.getElementById('{{ form.file.vars.id }}').files[0];
            var fileSizeInMegabytes = newFile.size > 1024 * 1024;
            var fileSize = fileSizeInMegabytes ? newFile.size / (1024 * 1024) : newFile.size / 1024;
            document.getElementById('{{ form.file.vars.id }}_new_file_name').innerText = newFile.name + ' (' + fileSize.toFixed(2) + ' ' + (fileSizeInMegabytes ? 'MB' : 'KB') + ')';
        {% endset %}

        <div class="ea-vich-image-actions">
            {# the container element is needed to allow customizing the <input type="file" /> #}
            <div class="{{ ea_ui_classes('btn btn-secondary input-file-container', 'button') }}">
                <twig:ea:Icon name="internal:upload" /> {{ 'action.choose_file'|trans({}, 'EasyAdminBundle') }}
                {{ form_widget(form.file, {attr: {onchange: file_upload_js}, vich: true}) }}
            </div>

            {% if form.delete is defined %}
                {{ form_row(form.delete) }}
            {% endif %}
        </div>
        <div class="small" id="{{ form.file.vars.id }}_new_file_name"></div>
    </div>
{% endblock %}

{% block ea_autocomplete_widget %}
    {{ form_widget(form.autocomplete, {attr: attr|merge({required: required})}) }}
{% endblock ea_autocomplete_widget %}

{% block ea_autocomplete_inner_label %}
    {% set name = form_parent(form).vars.name %}
    {{ block('form_label') }}
{% endblock ea_autocomplete_inner_label %}

{% block ea_code_editor_widget %}
    {{ form_widget(form, {attr: attr|merge({
        'data-ea-code-editor-field': 'true',
        'data-language': form.vars.ea_vars.field.customOptions.get('language')|default('markdown'),
        'data-tab-size': form.vars.ea_vars.field.customOptions.get('tabSize')|default(4),
        'data-indent-with-tabs': (form.vars.ea_vars.field.customOptions.get('indentWithTabs') ?? false) ? 'true' : 'false',
        'data-show-line-numbers': (form.vars.ea_vars.field.customOptions.get('showLineNumbers') ?? true) ? 'true' : 'false',
        'data-number-of-rows': form.vars.ea_vars.field.customOptions.get('numOfRows')|default(null),
    })}) }}
{% endblock ea_code_editor_widget %}

{% block ea_text_editor_widget %}
    {{ form_widget(form, {attr: attr|merge({
        class: html_classes(attr.class|default(''), 'ea-text-editor-content'),
        hidden: true,
        'data-number-of-rows': form.vars.ea_vars.field.customOptions.get('numOfRows')|default(5),
        'data-trix-editor-config': form.vars.ea_vars.field.customOptions.get('trixEditorConfig')|default(null)|json_encode,
    })}) }}

    <div class="ea-text-editor-wrapper {{ row_attr.class|default('') ~ (not valid ? ' has-error') }}">
        <trix-editor input="{{ id }}" class="trix-content" {% if disabled %}disabled{% endif %}></trix-editor>
    </div>
{% endblock ea_text_editor_widget %}

{% block ea_fileupload_widget %}
    <div class="ea-fileupload"
        data-ea-fileupload-field
        {% if allow_view %}data-allow-view{% endif %}
        {% if allow_download %}data-allow-download{% endif %}
        {% if allow_delete %}data-allow-delete{% endif %}
        {% if multiple %}data-multiple{% endif %}
        data-icon-generic="{{ component('ea:Icon', {name: 'filetypes:generic', class: 'ea-fileupload-card-icon'})|e('html_attr') }}"
        data-icon-view="{{ component('ea:Icon', {name: 'internal:detail'})|e('html_attr') }}"
        data-icon-download="{{ component('ea:Icon', {name: 'internal:download'})|e('html_attr') }}"
        data-icon-delete="{{ component('ea:Icon', {name: 'internal:xmark'})|e('html_attr') }}"
    >
        {{ form_widget(form.file, {attr: form.file.vars.attr|merge({class: form.file.vars.attr.class|default(''), hidden: true, 'data-ea-fileupload-input': ''})}) }}

        <div class="ea-fileupload-toolbar">
            {% set showAddButton = multiple or currentFiles is empty %}
            <button type="button" class="{{ ea_ui_classes('btn btn-secondary btn-sm ea-fileupload-add-btn', 'button') }}" data-ea-fileupload-add{% if not showAddButton %} hidden{% endif %}>
                <twig:ea:Icon name="internal:plus" class="btn-icon" />
                <span class="btn-label">
                    {{ multiple
                        ? 'file_upload.add_files'|trans({}, 'EasyAdminBundle')
                        : 'file_upload.add_file'|trans({}, 'EasyAdminBundle')
                    }}
                </span>
            </button>

            {% if multiple and allow_delete %}
                <button type="button" class="{{ ea_ui_classes('btn btn-sm ea-fileupload-clear-all-btn', 'button') }}" data-ea-fileupload-clear-all{% if currentFiles is empty %} hidden{% endif %}>
                    {{ 'file_upload.clear_all'|trans({}, 'EasyAdminBundle') }}
                </button>
            {% endif %}
        </div>

        <div class="ea-fileupload-cards" data-ea-fileupload-cards>
            {% for i, file in currentFiles %}
                {% set fileName = file.filename %}
                {% set fileSize = file.size ? file.size|ea_filesize : '' %}
                {% set filetypeIcon = fileName|ea_filetype_icon %}
                {% set isImage = (filetypeIcon == 'image')
                    or (filetypeIcon == 'vector' and (fileName|lower ends with '.svg' or fileName|lower ends with '.svgz')) %}
                {% set isVectorImage = filetypeIcon == 'vector' and (fileName|lower ends with '.svg' or fileName|lower ends with '.svgz') %}
                {% set fileUrl = currentFileUrls[i]|default(null) %}
                {% if fileUrl is null and download_path %}
                    {% set fileUrl = asset(download_path ~ currentFileNames[i]) %}
                {% endif %}

                <div class="ea-fileupload-card" data-ea-fileupload-card data-filename="{{ currentFileNames[i] }}">
                    <div class="ea-fileupload-card-preview">
                        {% if isImage and fileUrl %}
                            <img src="{{ fileUrl }}" alt="{{ fileName }}" class="ea-fileupload-card-thumbnail" />
                        {% else %}
                            <twig:ea:Icon name="filetypes:{{ filetypeIcon }}" class="ea-fileupload-card-icon" />
                        {% endif %}
                    </div>

                    <div class="ea-fileupload-card-info">
                        <span class="ea-fileupload-card-name">{{ fileName }}</span>
                        {% if fileSize %}
                            <span class="ea-fileupload-card-size">{{ fileSize }}</span>
                        {% endif %}
                    </div>

                    <div class="ea-fileupload-card-actions">
                        {% if allow_view and fileUrl and (risky_inline_render|default(false) or not (fileName|ea_force_download)) %}
                            <a href="{{ fileUrl }}" target="_blank" rel="noopener" class="ea-fileupload-action-btn ea-fileupload-action-view" title="{{ 'action.detail'|trans({}, 'EasyAdminBundle') }}">
                                <twig:ea:Icon name="internal:detail" />
                            </a>
                        {% endif %}
                        {% if allow_download and fileUrl %}
                            <a href="{{ fileUrl }}" download="{{ fileName }}" class="ea-fileupload-action-btn ea-fileupload-action-download" title="{{ 'action.download'|trans({}, 'EasyAdminBundle') }}">
                                <twig:ea:Icon name="internal:download" />
                            </a>
                        {% endif %}
                        {% if allow_delete %}
                            <button type="button" class="ea-fileupload-action-btn ea-fileupload-action-delete" data-ea-fileupload-delete-card>
                                <twig:ea:Icon name="internal:xmark" />
                            </button>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>

        {% if allow_delete %}
            <div hidden>{{ form_widget(form.delete, {label: false}) }}</div>
        {% endif %}
        <div hidden>{{ form_widget(form.deleted_files) }}</div>
    </div>
    {{ form_errors(form.file) }}
{% endblock %}

{% block ea_slug_widget %}
    {% set attr = attr|merge({
        'data-ea-slug-field': '',
        'data-target': target|split('|')|map(name => form.parent.children[name].vars.id)|json_encode,
    }) %}
    {% if attr['data-confirm-text'] is defined %}
        {% set attr = attr|merge({
            'data-confirm-text': attr['data-confirm-text']|trans,
        }) %}
    {% endif %}

    {# when the field defines prepend/append addons, the form_row block already wrapped
       this widget in an '.ea-input-group', so don't render a nested group here #}
    {% set ea_addons = ea_addons|default({prepend: [], append: []}) %}
    {% set is_inside_addon_group = ea_widget_is_inside_addon_group|default(false) %}

    {% set slug_widget %}
        {{ block('form_widget') }}
        <button type="button" class="ea-input-addon ea-input-addon-button" data-ea-slug-lock-button
                aria-pressed="true" {{ disabled ? 'disabled' }}
                data-icon-locked="{{ component('ea:Icon', {name: 'internal:lock'})|e('html') }}"
                data-icon-unlocked="{{ component('ea:Icon', {name: 'internal:lock-open-solid'})|e('html') }}">
            <twig:ea:Icon name="internal:lock" />
        </button>
    {% endset %}

    {% if is_inside_addon_group %}
        {{ slug_widget }}
    {% else %}
        <div class="ea-input-group {{ disabled ? 'ea-input-group-disabled' }}">{{ slug_widget }}</div>
    {% endif %}
{% endblock %}

{% block ea_filters_widget %}
    {% set applied_filters = ea().request.query.all()['filters']|default([])|keys %}
    {% for field in form %}
        {% set is_applied = field.vars.name in applied_filters %}
        {% set content_id = 'filter-content-' ~ loop.index %}
        {% set label_id = field.vars.label_attr.id|default('filter-label-' ~ loop.index) %}
        {% set has_help = field.vars.help is not same as(false) and field.vars.help is not null and field.vars.help is not same as('') %}
        {% set widget_attr = {'aria-labelledby': label_id}|merge(field.vars.attr) %}
        {% set toggle_attr = {id: label_id, 'data-ea-toggle': 'collapse', href: '#' ~ content_id, role: 'button', 'aria-expanded': is_applied ? 'true' : 'false', 'aria-controls': content_id}|merge(field.vars.label_attr|default({})|ea_ui_attrs) %}
        {% set descriptions = widget_attr['aria-describedby']|default('')|split(' ') %}
        {% if has_help and (field.vars.id ~ '_help') not in descriptions %}{% set descriptions = descriptions|merge([field.vars.id ~ '_help']) %}{% endif %}
        {% if field.vars.errors|length > 0 and (field.vars.id ~ '_errors') not in descriptions %}{% set descriptions = descriptions|merge([field.vars.id ~ '_errors']) %}{% endif %}
        {% if descriptions|join(' ')|trim is not empty %}{% set widget_attr = widget_attr|merge({'aria-describedby': descriptions|join(' ')|trim}) %}{% endif %}
        <div class="filter-field" data-filter-property="{{ field.vars.name }}">
            <div class="filter-heading" id="filter-heading-{{ loop.index }}">
                <input type="checkbox" class="checkbox filter-checkbox" aria-labelledby="{{ label_id }}"{% if is_applied %} checked{% endif %}>
                <a {% with {attr: toggle_attr} %}{{ block('attributes') }}{% endwith %}>
                    {% set has_filter_label = field.vars.label is ea_is_not_empty %}
                    {% set filter_label = has_filter_label ? field.vars.label : field.vars.name|humanize %}
                    {{ filter_label|trans(domain: ea().i18n.translationDomain) }}
                </a>
            </div>
            <div id="{{ content_id }}" class="filter-content" data-ea-collapse aria-labelledby="filter-heading-{{ loop.index }}"{% if not is_applied %} hidden{% endif %}>
                <div class="form-widget">
                    {{ form_widget(field, {attr: widget_attr}) }}
                    {{ form_help(field) }}
                    {% if 'ea_numeric_filter' not in field.vars.block_prefixes and 'ea_datetime_filter' not in field.vars.block_prefixes %}{{ form_errors(field) }}{% endif %}
                </div>
            </div>
        </div>
    {% endfor %}
{% endblock %}

{% block comparison_widget %}
    {{ form_widget(form, {attr: attr|merge({'data-ea-comparison-id': form.vars.id})}) }}
{% endblock %}

{% block ea_numeric_filter_widget %}
    {% set attr = attr|merge({class: html_classes(attr.class|default(''), 'form-widget-compound')}) %}
    <div {{ block('widget_container_attributes') }}>
        {{ form_row(form.comparison) }}
        {{ form_row(form.value) }}
        <div data-ea-value2-of-comparison-id="{{ form.comparison.vars.id }}"{% if form.comparison.vars.value != 'between' %} hidden{% endif %}>
            {{ form_row(form.value2) }}
        </div>
    </div>
    {{ form_errors(form) }}
{% endblock %}

{% block ea_datetime_filter_widget %}{{ block('ea_numeric_filter_widget') }}{% endblock %}
