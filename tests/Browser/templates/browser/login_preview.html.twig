{% extends '@EasyAdmin/page/login.html.twig' %}

{% block head_stylesheets %}
    {% if app.request.attributes.get('browser_ui_preview') %}
        <link rel="stylesheet" href="{{ asset('easyadmin/ui-preview.css') }}" nonce="{{ csp_nonce('style') }}" data-testid="auxiliary-stylesheet">
        <link rel="stylesheet" href="{{ asset('ui-fonts-preview.css', constant('EasyCorp\\Bundle\\EasyAdminBundle\\Asset\\AssetPackage::PACKAGE_NAME')) }}" nonce="{{ csp_nonce('style') }}">
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block head_javascript %}
    {% if app.request.attributes.get('browser_ui_preview') %}
        {{ importmap(['ui-interactions', 'ui-shell'], {nonce: csp_nonce('script')}) }}
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block header_logo %}{{ parent() }}<span data-testid="login-logo-override">{{ 'Login block override'|trans }}</span>{% endblock %}
{% block login_form_footer %}<p data-testid="login-footer-override">{{ 'Login footer override'|trans }}</p>{% endblock %}
